{
  "name": "setlist_multitrack",
  "version": "1.0.0",
  "description": "PULSO: reproductor multitrack para Android/iOS con desarrollo web local y Capacitor.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "sync": "npm run build && cap sync",
    "sync:copy": "npm run build && cap copy",
    "test:mobile": "npm run dev",
    "android:build": "npm run build && cap sync android && node scripts/android-build.cjs",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "dev": "node scripts/dev.cjs",
    "build": "node scripts/build.cjs",
    "tunnel": "node scripts/tunnel.cjs",
    "test": "npm run vendor && node scripts/check-source.cjs && node scripts/python.cjs -m unittest discover -s tests -p \"test_*.py\"",
    "test:browser": "playwright test",
    "vendor": "node scripts/prepare-vendor.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/screen-orientation": "^8.0.1",
    "jszip": "3.10.1",
    "lucide": "0.468.0",
    "signalsmith-stretch": "1.3.2"
  },
  "devDependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@playwright/test": "1.56.1",
    "acorn": "8.15.0",
    "eslint-scope": "8.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
